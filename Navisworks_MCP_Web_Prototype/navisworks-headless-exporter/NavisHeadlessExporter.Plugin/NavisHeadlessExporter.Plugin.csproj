<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>NavisHeadlessExporter</AssemblyName>
    <RootNamespace>NavisHeadlessExporter</RootNamespace>
    <NavisworksInstall Condition="'$(NavisworksInstall)' == ''">D:\Navisworks Manage 2027</NavisworksInstall>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstall)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
