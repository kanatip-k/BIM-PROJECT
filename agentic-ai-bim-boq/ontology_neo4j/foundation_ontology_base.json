{
  "schemaVersion": "0.1.0",
  "ontologyId": "boq-foundation-poc",
  "name": "BOQ Foundation Cost Code Ontology - Neo4j Base",
  "language": "th-TH",
  "status": "draft-proof-of-concept",
  "createdDate": "2026-10-29",
  "description": "ฐานข้อมูลกราฟตัวอย่างสำหรับเชื่อมแนวคิดระบบฐานราก องค์ประกอบ BIM รายการ BOQ กฎวัดปริมาณ UniFormat และ EIT Cost Code โดยไม่สร้างรหัสที่ยังไม่ได้รับการยืนยัน",
  "designPrinciples": [
    "Construction concept, BOQ work item, classification code, cost code and measurement rule are separate node types.",
    "One construction concept may generate multiple BOQ work items.",
    "needs_review and unresolved mappings must not be returned as confirmed cost codes.",
    "Unknown mappings remain null and are represented by issue nodes.",
    "MasterFormat and OmniClass codes are not populated until a licensed and reviewed source is available."
  ],
  "sources": [
    {
      "id": "source:boq_rules",
      "path": "python_app/boq_workflow/config/boq_element_rules.json",
      "role": "BOQ work items and measurement requirements"
    },
    {
      "id": "source:boq_eit_crosswalk",
      "path": "python_app/boq_workflow/config/boq_to_eit_mapping.json",
      "role": "BOQ to EIT crosswalk and mapping status"
    },
    {
      "id": "source:eit_reference",
      "path": "python_app/boq_workflow/config/eit_cost_code_reference.json",
      "role": "EIT code titles and hierarchy"
    },
    {
      "id": "source:case2",
      "path": "data/export/CASE2_ST_ALL.boq.json",
      "role": "Observed BIM evidence and UniFormat signals"
    }
  ],
  "pendingExternalSchemes": [
    {
      "scheme": "MASTERFORMAT",
      "status": "not_loaded",
      "reason": "No licensed and expert-reviewed code source has been approved for this project."
    },
    {
      "scheme": "OMNICLASS",
      "status": "not_loaded",
      "reason": "Table-specific codes have not been confirmed from a licensed source."
    }
  ],
